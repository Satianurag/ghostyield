# Bitcoin Network Configuration
BITCOIN_RPC="http://localhost:18332"

# EVM Network Configuration (Base Sepolia)
BASE_SEPOLIA_RPC="https://sepolia.base.org"
PRIVATE_KEY="0x..."  # Your EVM deployer private key
BASESCAN_API_KEY="..."

# Backend Configuration
PORT=3001

# Frontend Configuration (VITE_ prefix required for Vite)
# RainbowKit Project ID - Get from https://cloud.walletconnect.com/
VITE_RAINBOW_PROJECT_ID="..."

# RPC URL for frontend (use local Hardhat node for dev, Base Sepolia for prod)
VITE_RPC_URL="http://127.0.0.1:8545"

# Contract Addresses (update after deployment)
VITE_GHOST_LENDING_ADDRESS="0x..."
VITE_GHOST_USD_ADDRESS="0x..."
VITE_GHOST_POOL_ADDRESS="0x..."
VITE_VAULT_NFT_ADDRESS="0x..."
VITE_VERIFIER_ADDRESS="0x..."

# Chainlink BTC/USD Price Feed on Base Sepolia
VITE_PRICE_FEED_ADDRESS="0xd94e4C1C3bB697AAE92744FAA4E43B5c2Ef11f16"

# USDC on Base Sepolia
VITE_USDC_ADDRESS="0x036CbD53842c5426634e7929541eC2318f3dCF7e"

# Backend API URL
VITE_API_URL="http://localhost:3001"
